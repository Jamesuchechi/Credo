# Database & Redis
DATABASE_URL=postgresql+asyncpg://credo:credopassword@localhost:5432/credo
REDIS_URL=redis://localhost:6379/0

# App Settings
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Corroboration & Fact-Check APIs
NEWS_API_KEY=your_news_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# Source Intelligence
WHOIS_API_KEY=your_whois_api_key_here

# Media Analysis
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Social Ingestion APIs (Reddit uses public .json endpoint — no keys required)
X_API_BEARER_TOKEN=your_x_api_bearer_token_here

# Credibility Receipt Cryptographic Signing Key
RECEIPT_SIGNING_KEY=your_receipt_signing_key_here_min_32_chars

